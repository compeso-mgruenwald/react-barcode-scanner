{
  "name": "react-barcode-scanner",
  "private": true,
  "description": "A React component for scanning QR codes and other barcodes via webcam",
  "homepage": "https://github.com/compeso-mgruenwald/react-barcode-scanner#readme",
  "bugs": {
    "url": "https://github.com/compeso-mgruenwald/react-barcode-scanner/issues"
  },
  "license": "MIT",
  "author": "Marcel Grünwald",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/compeso-mgruenwald/react-barcode-scanner.git"
  },
  "type": "module",
  "scripts": {
    "build": "vp -C packages/react-barcode-scanner pack",
    "dev": "vp -C apps/example dev",
    "preview": "vp -C apps/example preview",
    "fmt": "vp fmt",
    "lint:fix": "vp lint --fix",
    "lint:incl-warnings": "vp lint",
    "vp-check": "vp check",
    "check": "pnpm vp-check && pnpm build && pnpm test && vp -C apps/example build",
    "check:agents": "pnpm vp-check && pnpm build",
    "test": "vp -C packages/react-barcode-scanner test --coverage",
    "prepare": "bun run husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "husky": "^9.1.7",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.3.4",
      "onFail": "error"
    }
  }
}
