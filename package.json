{
  "name": "@thewirv/react-barcode-scanner",
  "version": "3.4.0",
  "description": "A React component for scanning QR codes and other barcodes via webcam",
  "keywords": [
    "barcode",
    "barcodescanner",
    "code",
    "codescanner",
    "qr",
    "qrcode",
    "qrcodereader",
    "qrcodescanner",
    "qrreader",
    "qrscanner",
    "react",
    "scanner"
  ],
  "homepage": "https://github.com/compeso-mgruenwald/react-barcode-scanner#readme",
  "bugs": {
    "url": "https://github.com/compeso-mgruenwald/react-barcode-scanner/issues"
  },
  "license": "MIT",
  "author": "Marcel Grünwald",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/compeso-mgruenwald/react-barcode-scanner.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "bun run build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --quiet",
    "lint:fix": "oxlint --fix",
    "lint:incl-warnings": "oxlint",
    "typecheck": "tsc -b",
    "check": "npm run typecheck && npm run fmt:check && npm run lint && npm run build && npm run test",
    "check:agents": "npm run typecheck && npm run fmt:check && npm run lint && npm run build",
    "test": "true",
    "prepare": "bun run husky"
  },
  "dependencies": {
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/react": "^19.1.8",
    "husky": "^9.1.7",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "publint": "^0.3.24",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "unplugin-unused": "^0.6.0"
  },
  "peerDependencies": {
    "react": "^16.8.0 || 17.x || 18.x || 19.x",
    "react-dom": "^16.8.0 || 17.x || 18.x || 19.x",
    "react-icons": ">=4.8"
  },
  "engines": {
    "node": ">=20"
  }
}
